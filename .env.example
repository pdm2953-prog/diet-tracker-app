# Web development uses localhost so its SameSite=Strict auth cookie shares the
# same site as the default Expo web URL. For an Android emulator use
# http://10.0.2.2:8000; for a physical device use the development PC's LAN IP.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
# Optional: backend, mock, or backend-with-mock-fallback. Defaults to backend.
# EXPO_PUBLIC_FOOD_SEARCH_PROVIDER=backend
