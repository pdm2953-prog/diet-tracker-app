APP_NAME=Diet Tracker Backend
APP_VERSION=0.1.0
BACKEND_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082

# Food provider: mock or fatsecret. mock is safe for local development without credentials.
FOOD_PROVIDER=mock

# FatSecret settings. Do not put real secrets in this example file.
FATSECRET_API_EDITION=basic
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# Basic edition uses US/en data only. Premier can use licensed region/language values.
FATSECRET_REGION=US
FATSECRET_LANGUAGE=en
FATSECRET_TIMEOUT_SECONDS=10
FATSECRET_TOKEN_REFRESH_MARGIN_SECONDS=60
FATSECRET_BASIC_MAX_RESULTS=10
FATSECRET_DETAIL_CONCURRENCY=4

# K-FIND/MFDS diagnostic settings. Put the public data portal Encoding key value here.
KFOOD_API_KEY_ENCODED=
KFOOD_BASE_URL=https://apis.data.go.kr/1471000/FoodNtrCpntDbInfo02
KFOOD_TIMEOUT_SECONDS=10
